  "dependencies": {
    "browser-sync": "^2.26.7",
    "cli": "^1.0.1",
    "gulp-data": "^1.3.1",
    "gulp-pug": "^3.3.0",
    "gulp-watch": "^4.3.11",
    "moment": "^2.22.2",
    "pug": "^2.0.3",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
